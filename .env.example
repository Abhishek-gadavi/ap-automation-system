# ==============================================================================
# Environment Configuration Template (DO NOT COMMIT REAL SECRETS)
# ==============================================================================

# Database Configuration (PostgreSQL through Docker)
POSTGRES_DB=accounts_payable_db
POSTGRES_USER=accounts_user
POSTGRES_PASSWORD=your_secure_password_here
DB_HOST=localhost
DB_PORT=5432
USE_POSTGRES=True

# Django Core
DJANGO_SECRET_KEY=change-this-in-production-to-a-random-secret-key
DEBUG=True
ALLOWED_HOSTS=*

# JWT Authentication
JWT_SECRET_KEY=change-this-jwt-secret
JWT_ACCESS_LIFETIME_MINUTES=60
JWT_REFRESH_LIFETIME_DAYS=7

# Email & Notification SMTP Settings
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@domain.com
SMTP_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=no-reply@domain.com

# OCR Configurations
TESSERACT_CMD=tesseract
OCR_CONFIDENCE_THRESHOLD=85.0
PRICE_TOLERANCE_PERCENT=2.0
